NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=60000

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

CORS_ORIGIN=*
LOG_LEVEL=info

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
