NODE_ENV=production
PORT=3000
API_PREFIX=api
SWAGGER_ENABLED=false

APP_NAME=API
APP_DESCRIPTION=Enterprise NestJS starter API

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL=60000

JWT_SECRET=CHANGE_ME_SET_A_REAL_SECRET_VIA_DEPLOYMENT_ENV_OR_SECRETS_MANAGER
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MIN=30

# Set via deployment env or secrets manager; leave empty here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

CORS_ORIGIN=https://your-domain.example.com
LOG_LEVEL=info

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
