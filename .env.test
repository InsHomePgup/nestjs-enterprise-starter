NODE_ENV=test
PORT=3001
API_PREFIX=api
SWAGGER_ENABLED=false

APP_NAME=API
APP_DESCRIPTION=Enterprise NestJS starter API

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db_test

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=60000

JWT_SECRET=test-only-secret-not-for-real-use
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=4
PASSWORD_RESET_EXPIRES_MIN=30

THROTTLE_TTL=60000
THROTTLE_LIMIT=1000

CORS_ORIGIN=*
LOG_LEVEL=silent

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db_test
